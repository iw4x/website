# Tools for regenerating www/hero/maps/ and www/server-list/maps/ from the
# game's files. We distribute them so that anyone with a copy of those can
# do that. They aren't part of the site, so nothing here gets installed.
#
./: file{hero/convert.py hero/views.py hero/serve.py hero/visibility.html \
         hero/drop.json \
         hero/visible/*.json \
         server-list/previews.py}

file{*}: install = false
