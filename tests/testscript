+export BDEP_SYNC=0

: sources
:
{{
  : hreflang-matches-linguas
  :
  {
    echo en >=expected
    for l: $linguas
      echo $l >+expected

    for f: index.html servers.html
    {
      sed -n -e 's%^ *<link rel="alternate" hreflang="([a-z]+)" .*%\1%p' \
        $project_src/www/$f >=actual

      diff expected actual
    }
  }

  : every-language-has-a-catalogue
  :
  for l: $linguas
    test -f $project_src/po/$(l).po

  : catalogues-are-complete
  :
  for l: $linguas
    msgfmt --check --output-file=- $project_src/po/$(l).po >- 2>-

  : tailwind-sources-match-scan
  :
  {
    sed -n -e 's%^@source "\./(.+)";$%\1%p' $project_src/www/tailwind.css >>EOO
    index.html
    servers.html
    404.html
    release-row.html
    EOO

    sed -n -e 's%^tailwind_scan = (.+)$%\1%p' $project_src/www/buildfile \
      >'html{index servers 404} file{release-row.html}'
  }

  # We have two scripts, the hero background on both pages and, on the
  # server browser, server-list/main.js. Both are external modules so that
  # the CSP can stay at script-src 'self', which also means that nothing
  # else may script: no inline code, no handlers, and no javascript: URLs.
  #
  : only-our-own-scripts
  :
  {
    sed -n -e 's%^ *(<script.*)$%\1%p' $project_src/www/index.html >>EOO
    <script type="module" src="../hero/main.js"></script>
    EOO

    sed -n -e 's%^ *(<script.*)$%\1%p' $project_src/www/servers.html >>EOO
    <script type="module" src="../../hero/main.js"></script>
    <script type="module" src="../../server-list/main.js"></script>
    EOO

    for f: index.html servers.html 404.html release-row.html
    {
      sed -n -e 's%.*( on[a-z]+=").*%\1%p' $project_src/www/$f
      sed -n -e 's%.*(javascript:).*%\1%p' $project_src/www/$f
    }

    for f: 404.html release-row.html
      sed -n -e 's%.*(<script).*%\1%p' $project_src/www/$f
  }

  : no-translatable-attributes
  :
  for f: index.html servers.html
    sed -n -e 's%.*(aria-label=).*%\1%p' $project_src/www/$f

  # The server browser's script finds its text in the page by id, the
  # same way the release archive finds its strings in po/strings.html.
  # So every id that the script asks for has to be in the page.
  #
  : the-server-browser-has-every-string-its-script-looks-up
  :
  {
    # Note that the sort is announced with text (sort.dir), so the two
    # directions are not in the script as literals. Note also that \x27
    # is the single quote that the script's literals are in.
    #
    sed -n -e 's%.*text [(]\x27([a-z]+)\x27.*%\1%p' \
      $project_src/www/server-list/main.js >=wanted

    echo ascending >+wanted
    echo descending >+wanted

    sed -n -e 's%^ *<p id="servers-text-([a-z]+)">.*</p>$%\1%p' \
      $project_src/www/servers.html >=have

    for -n w <=wanted
      sed -n -e "s%^$w\$%found%p" have >'found'
  }

  # The script only asks for the thumbnails that maps/index.json lists,
  # so every map in there needs its thumbnail and every thumbnail needs
  # its map in there.
  #
  : every-listed-map-thumbnail-is-there
  :
  {
    d = $project_src/www/server-list/maps

    sed -n -e 's%^"(mp_[a-z0-9_]+)",?$%\1%p' $d/index.json >=listed

    for -n m <=listed
      test -f $d/$(m).webp

    for f: $path_search('*.webp', $d)
    {
      m = $path.base($path.leaf([path] $f))
      sed -n -e "s%^$m\$%found%p" listed >'found'
    }
  }

  : the-server-browser-has-somewhere-to-put-the-list-url
  :
  sed -n -e 's%.*data-src="(@servers-url@)".*%\1%p' \
    $project_src/www/servers.html >'@servers-url@'

  : the-page-has-somewhere-to-put-the-archive
  :
  {
    sed -n -e 's%^ *(<!--@releases@-->)$%\1%p' $project_src/www/index.html \
      >'<!--@releases@-->'

    sed -n -e 's%.*<!--@releases@-->.*%found%p' $project_src/www/index.html \
      >'found'
  }

  : the-row-uses-the-placeholders-the-build-fills
  :
  {
    for p: @tag@ @date@ @date-text@ @notes-url@ @notes-text@ \
           @download-url@ @download-text@
    {
      sed -n -e "s%.*$p.*%found%p" $project_src/www/release-row.html >'found'
      sed -n -e "s%.*$p.*%found%p" $project_src/www/buildfile >'found'
    }

    sed -e 's%@tag@%%g'           \
        -e 's%@date-text@%%g'     \
        -e 's%@date@%%g'          \
        -e 's%@notes-url@%%g'     \
        -e 's%@notes-text@%%g'    \
        -e 's%@download-url@%%g'  \
        -e 's%@download-text@%%g' \
        $project_src/www/release-row.html | \
      sed -n -e 's%.*(@[a-z-]+@).*%\1%p'
  }

  : the-archive-text-has-every-string-the-build-looks-up
  :
  {
    sed -n -e 's%^ *<p id="([a-z0-9-]+)">.*</p>$%\1%p' \
      $project_src/po/strings.html >>EOO
    release-date
    release-month-01
    release-month-02
    release-month-03
    release-month-04
    release-month-05
    release-month-06
    release-month-07
    release-month-08
    release-month-09
    release-month-10
    release-month-11
    release-month-12
    release-changelog
    release-download
    EOO

    sed -n -e 's%^ *<p id="release-date">.*[{]year[}].*</p>$%found%p' \
      $project_src/po/strings.html >'found'

    sed -n -e 's%^ *<p id="release-date">.*[{]month[}].*</p>$%found%p' \
      $project_src/po/strings.html >'found'

    sed -n -e 's%^ *<p id="release-date">.*[{]day[}].*</p>$%found%p' \
      $project_src/po/strings.html >'found'
  }

  : the-archive-text-is-a-translation-input
  :
  sed -n -e 's%^(po/strings\.html)$%\1%p' $project_src/po/POTFILES \
    >'po/strings.html'
}}

: build
:
{{
  out = $~/out

  site = $~/stage/share/iw4x-website/www

  +$* 'configure:' $project_src/@$out/                        \
     "config.iw4x_website.tailwind=$tailwind"                 \
     "config.iw4x_website.tailwind.checksum=$tailwind_sha256" \
     "config.iw4x_website.releases=$releases"                 \
     &$out/*** >! 2>!

  +$* $out/ >! 2>!

  +$* 'install:' $out/ "config.install.root=$~/stage" &$~/stage/*** >! 2>!

  : published-files
  :
  {
    test -f $site/site.css
    test -f $site/en/index.html
    test -f $site/404.html
    test -f $site/favicon.ico
    test -f $site/sitemap.xml
    test -f $site/robots.txt
    test -f $site/.htaccess

    test -f $site/inter/latin.woff2
    test -f $site/inter/latin-ext.woff2
    test -f $site/inter/LICENSE

    test -f $site/inter/buildfile == 1
    test -f $site/buildfile == 1
    test -f $site/tailwind.css == 1

    test -f $site/en/servers/index.html
    test -f $site/server-list/main.js
    test -f $site/server-list/maps/index.json
    test -f $site/server-list/maps/mp_rust.webp
    test -f $site/server-list/buildfile == 1

    test -f $site/servers.html == 1
    test -d $site/servers == 1
    test -f $site/en/servers.html == 1
    test -f $site/en/server-list/main.js == 1

    for l: $linguas
    {
      test -f $site/$l/index.html
      test -f $site/$l/servers/index.html
    }
  }

  : server-browser
  :
  {{
    page = $site/en/servers/index.html

    : asks-the-configured-master-server
    :
    sed -n -e 's%.*data-src="([^"]*)".*%\1%p' $page \
      >'https://master.iw4x.io/v1/servers/iw4x?protocol=153'

    : may-connect-to-the-master-server
    :
    sed -n -e 's%.*connect-src ([^;]*);.*%\1%p' $site/.htaccess \
      >"'self' https://master.iw4x.io"

    : has-the-text-its-script-writes
    :
    sed -n -e 's%^ *<p id="(servers-text-summary)">.*[{]shown[}].*</p>$%\1%p' \
      $page >'servers-text-summary'

    : has-no-self-closed-elements-that-html-would-leave-open
    :
    sed -n -e 's%.*(<(script|div|span|p|tbody|td)( [^>]*)?/>).*%\1%p' $page
  }}

  : release-archive
  :
  {{
    page = $site/en/index.html

    : has-one-row-per-published-release
    :
    {
      sed -n -e 's%.*(<li class="grid gap-x-8).*%row%p' $page >>EOO
      row
      row
      row
      row
      row
      EOO

      sed -n -e 's%.*(@releases@).*%\1%p' $page
    }

    : names-the-releases-in-feed-order
    :
    {
      sed -n -e 's%.*<span translate="no" [^>]*>(r[^<]*)</span>.*%\1%p' \
        $page >>EOO
      r9003
      r9002
      r&lt;&amp;9001&gt;
      r9000
      r8999
      EOO
    }

    : leaves-out-drafts-prereleases-and-anything-past-the-row-count
    :
    {
      for t: r9005 r9004 r8998
        sed -n -e "s%.*($t).*%\1%p" $page
    }

    : writes-each-date-twice-once-for-machines-and-once-for-people
    :
    {
      sed -n -e 's%.*datetime="([0-9-]+)".*%\1%p' $page >>EOO
      2026-12-24
      2026-11-03
      2026-06-08
      2026-06-07
      2026-01-01
      EOO

      sed -n -e 's%.*>([A-Z][a-z]+ [0-9]+, [0-9]{4}).*%\1%p' $page >>EOO
      December 24, 2026
      November 3, 2026
      June 8, 2026
      June 7, 2026
      January 1, 2026
      EOO
    }

    : links-the-configured-asset
    :
    sed -n -e 's%.*href="(https://cdn\.example\.org/[^"]+)".*%\1%p' $page \
      >'https://cdn.example.org/get?file=iw4x.dll&amp;release=r9003'

    : falls-back-to-the-release-page-when-the-asset-is-missing
    :
    {
      sed -n -e 's%.*href="(https://github\.com/iw4x/iw4x-client/releases/tag/r9002)".*%\1%p' \
        $page >>EOO
      https://github.com/iw4x/iw4x-client/releases/tag/r9002
      https://github.com/iw4x/iw4x-client/releases/tag/r9002
      EOO
    }

    : escapes-what-it-takes-from-the-feed
    :
    {
      sed -n -e 's%.*(<span translate="no" [^>]*>r<).*%\1%p' $page
      sed -n -e 's%.*href="[^"]*[?][^"]*&[^a][^"]*".*%found%p' $page
    }

    : is-not-served-the-archive-text-or-the-row-markup
    :
    {
      test -f $site/release-row.html == 1
      test -f $site/strings.html == 1
      test -f $site/en/strings.html == 1
      test -f $site/releases.json == 1
    }
  }}

  : nothing-is-generated-into-the-source-tree
  :
  {
    test -f $project_src/www/site.css == 1
    test -d $project_src/www/en == 1
    test -f $project_src/po/iw4x.pot == 1
  }

  : english-page-is-the-authored-document
  :
  {
    sed -n -e 's%^<html [^>]*lang="([a-z]+)" xml:lang="[a-z]+">$%\1%p' \
      $site/en/index.html >'en'

    sed -n -e 's%^ *>(Multiplayer client[^<]*)</p$%\1%p' \
      $site/en/index.html >'Multiplayer client for Call of Duty: Modern Warfare 2.'
  }

  : pages-are-servable-as-text-html
  :
  for l: en $linguas
  {
    for p: $l/index.html $l/servers/index.html
    {
      sed -n -e 's%^(<!DOCTYPE html>)$%\1%p' $site/$p >'<!DOCTYPE html>'

      sed -n -e 's%^(<[?]xml).*%\1%p' $site/$p

      sed -n -e 's%^(<html [^>]*xml:lang="[a-z]+">)$%found%p' $site/$p \
        >'found'

      sed -n -e 's%^[^<].*( xml:lang=").*%\1%p' $site/$p
    }
  }

  : published-pages-carry-only-our-scripts
  :
  for l: en $linguas
  {
    sed -n -e 's%^ *(<script.*)$%\1%p' $site/$l/index.html >>EOO
    <script type="module" src="../hero/main.js"></script>
    EOO

    sed -n -e 's%^ *(<script.*)$%\1%p' $site/$l/servers/index.html >>EOO
    <script type="module" src="../../hero/main.js"></script>
    <script type="module" src="../../server-list/main.js"></script>
    EOO

    sed -n -e 's%.*( on[a-z]+=").*%\1%p' $site/$l/index.html
    sed -n -e 's%.*( on[a-z]+=").*%\1%p' $site/$l/servers/index.html
  }

  : internal-links-resolve
  :
  {
    for l: en $linguas
    {
      sed -n -e 's%.*href="(/[^"#]*)".*%\1%p' $site/$l/index.html >=abs
      sed -n -e 's%.*href="\.\./([^"#]+)".*%\1%p' $site/$l/index.html >=rel

      for -n p <=abs
        test -f $site$p/index.html

      for -n r <=rel
        test -f $site/$r

      # The server browser is one level deeper and so reaches the site
      # root with ../../. It also links to the homepage of its own
      # language, never to another one.
      #
      p = $site/$l/servers/index.html

      sed -n -e 's%.*href="(/[^"#]*)".*%\1%p' $p >=abs
      sed -n -e 's%.*(href|src)="\.\./\.\./([^"#]+)".*%\2%p' $p >=rel

      for -n a <=abs
        test -f $site$a/index.html

      for -n r <=rel
        test -f $site/$r

      sed -n -e 's%.*href="/([a-z]+)[#/"].*%\1%p' $p >=langs

      sed -e "s%^$l\$%%" langs | sed -n -e 's%^(.+)$%\1%p'
    }

    sed -n -e 's%.*href="(/[^"#]*)".*%\1%p' $site/404.html >=abs
    sed -n -e 's%.*href="([a-z][^":#]*)".*%\1%p' $site/404.html >=rel

    for -n p <=abs
      test -f $site$p/index.html

    for -n r <=rel
      test -f $site/$r

    for l: en $linguas
      sed -n -e 's%.*(rel="stylesheet" href="/).*%\1%p' $site/$l/index.html
  }

  : stylesheet
  :
  {
    for u: text-muted bg-accent border-rule text-display tracking-body \
           text-wordmark-accent max-w-120 sr-only
      sed -n -e "s%.*[.]$u[,{ ].*%found%p" $site/site.css >'found'

    sed -n -e 's%.*[.]text-display[{][^}]*line-height[^}]*[}].*%found%p' \
      $site/site.css >'found'

    sed -n -e 's%.*[.]text-heading[{][^}]*line-height[^}]*[}].*%found%p' \
      $site/site.css >'found'

    sed -n -e 's%.*(10rem_1fr).*%\1%p' $site/site.css >'10rem_1fr'

    for l: en $linguas
      sed -n -e 's%.*<link rel="stylesheet" href="([^"]+)" ?/>.*%\1%p' \
        $site/$l/index.html >'../site.css'

    sed -n -e 's%.*<link rel="stylesheet" href="([^"]+)" ?/>.*%\1%p' \
      $site/404.html >'../site.css'
  }

  : generated-pages-are-well-formed
  :
  ifn! $xmllint
  {
    for l: en $linguas
    {
      $xmllint --noout $site/$l/index.html
      $xmllint --noout $site/$l/servers/index.html
    }

    $xmllint --noout $site/404.html
    $xmllint --noout $site/sitemap.xml
  }

  : webfont-is-self-hosted
  :
  {
    sed -n -e 's%.*url[(]inter/latin[.]woff2[)].*%found%p' \
      $site/site.css >'found'

    sed -n -e 's%.*url[(]inter/latin-ext[.]woff2[)].*%found%p' \
      $site/site.css >'found'

    test -f $site/inter/latin.woff2
    test -f $site/inter/latin-ext.woff2

    for l: en $linguas
      sed -n -e 's%.*<link rel="preload" as="font" [^>]*href="([^"]+)".*%\1%p' \
        $site/$l/index.html >'../inter/latin.woff2'

    sed -n -e 's%.*(fonts[.]googleapis[.]com).*%\1%p' $site/site.css
    sed -n -e 's%.*(fonts[.]gstatic[.]com).*%\1%p' $site/site.css
    sed -n -e 's%.*(@import url[(]http).*%\1%p' $site/site.css

    sed -n -e 's%.*(font-src .self.).*%\1%p' $site/.htaccess >"font-src 'self'"
  }

  : the-font-licence-ships-with-the-font
  :
  {
    sed -n -e 's%^(Copyright [(]c[)] 2016 The Inter Project Authors).*%\1%p' \
      $site/inter/LICENSE >'Copyright (c) 2016 The Inter Project Authors'

    sed -n -e 's%^(SIL OPEN FONT LICENSE Version 1[.]1).*%\1%p' \
      $site/inter/LICENSE >'SIL OPEN FONT LICENSE Version 1.1'
  }

  : sitemap-lists-every-page-in-every-language
  :
  {
    echo en >=expected
    for l: $linguas
      echo $l >+expected
    echo en/servers >+expected
    for l: $linguas
      echo $l/servers >+expected

    sed -n -e 's%^ *<loc>https://iw4x\.io/([a-z/]+)</loc>$%\1%p' \
      $site/sitemap.xml >=actual

    diff expected actual
  }

  : server-rules-know-every-language
  :
  sed -n -e 's%.*\!\^/\(\?:([a-z|]+)\).*%\1%p' $site/.htaccess \
    >"$regex.merge(en $linguas, '(.+)', '\1', '|')"

  -$* $out/ 2>>~%EOE%
    %info: dir\{.+\} is up to date%
    EOE
}}

: translation
:
{{
  +$* 'configure:' $project_src/@$~/cfg/       \
     "config.iw4x_website.releases=$releases" \
     &$~/cfg/*** >! 2>!

  +$* 'dist:' $~/cfg/ "config.dist.root=$~/dist" config.dist.uncommitted=true \
     &$~/dist/*** >! 2>!

  +find $~/dist -mindepth 1 -maxdepth 1 -type d | set -n authored [dir_path]

  : a-catalogue-produces-a-translated-page
  :
  {
    cp -r $authored src

    cat <<EOI >=src/po/zz.po
    msgid ""
    msgstr ""
    "MIME-Version: 1.0\n"
    "Content-Type: text/plain; charset=UTF-8\n"
    "Content-Transfer-Encoding: 8bit\n"
    "Language: zz\n"

    msgid "Multiplayer client for Call of Duty: Modern Warfare 2."
    msgstr "ZZ TAGLINE"

    msgid "IW4x on Discord"
    msgstr "ZZ DISCORD"

    msgid "{month} {day}, {year}"
    msgstr "{day}. {month} {year}"

    msgid "January"
    msgstr "ZZ-Januar"

    msgid "June"
    msgstr "ZZ-Juni"

    msgid "November"
    msgstr "ZZ-November"

    msgid "December"
    msgstr "ZZ-Dezember"

    msgid "Changelog"
    msgstr "ZZ-CHANGELOG"

    msgid "Download"
    msgstr "ZZ-DOWNLOAD"

    msgid "Join"
    msgstr "ZZ-JOIN"

    msgid "Bots: {count}"
    msgstr "ZZ-BOTS {count}"
    EOI

    echo zz >=src/po/LINGUAS

    $* 'configure:' $~/src/@$~/out/                             \
       "config.iw4x_website.tailwind=$tailwind"                 \
       "config.iw4x_website.tailwind.checksum=$tailwind_sha256" \
       "config.iw4x_website.releases=$releases"                 \
       &$~/out/*** >! 2>!

    $* $~/out/ >! 2>!

    page = $~/out/www/zz/index.html

    sed -n -e 's%^<html [^>]*lang="([a-z]+)" xml:lang="[a-z]+">$%\1%p' \
      $page >'zz'

    sed -n -e 's%^ *<link rel="canonical" href="https://iw4x\.io/([a-z]+)"/>$%\1%p' \
      $page >'zz'

    sed -n -e 's%^ *(<script.*)$%\1%p' $page >>EOO
    <script type="module" src="../hero/main.js"></script>
    EOO

    sed -n -e 's%.*(<(script|div|span)( [^>]*)?/>).*%\1%p' $page

    sed -n -e 's%.*>(ZZ TAGLINE)</p>.*%\1%p' $page >'ZZ TAGLINE'

    sed -n -e 's%.*>(ZZ DISCORD)</a>.*%\1%p' $page >'ZZ DISCORD'

    sed -n -e 's%.*>(IW4)<span class="text-wordmark-accent">x</span>.*%\1%p' \
      $page >'IW4'

    sed -n -e 's%.*>([0-9]+\. ZZ-[A-Za-z]+ [0-9]{4}).*%\1%p' $page >>EOO
    24. ZZ-Dezember 2026
    3. ZZ-November 2026
    8. ZZ-Juni 2026
    7. ZZ-Juni 2026
    1. ZZ-Januar 2026
    EOO

    sed -n -e 's%.*>(ZZ-CHANGELOG).*%\1%p' $page >>EOO
    ZZ-CHANGELOG
    ZZ-CHANGELOG
    ZZ-CHANGELOG
    ZZ-CHANGELOG
    ZZ-CHANGELOG
    EOO

    sed -n -e 's%.*<span translate="no" [^>]*>(r8999)</span>.*%\1%p' \
      $page >'r8999'

    sed -n -e 's%^(<!DOCTYPE html>)$%\1%p' $page >'<!DOCTYPE html>'
    sed -n -e 's%^(<[?]xml).*%\1%p' $page
    sed -n -e 's%^[^<].*( xml:lang=").*%\1%p' $page

    sed -n -e 's%.*href="(/zz/servers)".*%\1%p' $page >'/zz/servers'

    # The server browser goes through the same msgfmt pass, which leaves
    # rather more of its elements empty than the homepage does: the table
    # body, the announcer, and the cells of the row template.
    #
    servers = $~/out/www/zz/servers/index.html

    sed -n -e 's%^<html [^>]*lang="([a-z]+)" xml:lang="[a-z]+">$%\1%p' \
      $servers >'zz'

    sed -n -e 's%^ *<link rel="canonical" href="https://iw4x\.io/([a-z/]+)"/>$%\1%p' \
      $servers >'zz/servers'

    sed -n -e 's%.*(<(script|div|span|p|tbody|td)( [^>]*)?/>).*%\1%p' $servers

    sed -n -e 's%.*<span>(ZZ-JOIN)</span>.*%\1%p' $servers >'ZZ-JOIN'

    sed -n -e 's%^ *<p id="servers-text-bots">(.+)</p>$%\1%p' $servers \
      >'ZZ-BOTS {count}'

    sed -n -e 's%.*data-src="([^"]+)".*%\1%p' $servers \
      >'https://master.iw4x.io/v1/servers/iw4x?protocol=153'

    sed -n -e 's%.*href="/(en)[#/"].*%\1%p' $servers
  }
}}

