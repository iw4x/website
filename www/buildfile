# Keep generated files out of the source tree. This is useful for the
# usual out-of-tree build reasons, though in this project it gives us
# something a little stronger as well: anything under www/ is input that
# somebody maintains and anything under the corresponding output
# directory is produced by the build.
#
# This makes the output directory a fairly literal image of the website
# we are going to install. In particular, starting with this source
# directory and an empty output directory must be enough to reproduce
# the published site. If we ever find ourselves relying on a generated
# file left in www/, then we have broken that property.

# The pages below read the release archive text that po/buildfile
# translates, so that directory has to be loaded before this one.
#
include ../po/

# tailwind.build has already selected the Tailwind artifact for this
# host. At this point we know its URL and checksum, and possibly have a
# configured local copy. What remains is to turn that selection into an
# executable that the rest of this build can depend on.
#
# It may be tempting to acquire Tailwind directly from the site.css
# recipe. Giving the executable its own target is useful here. build2
# can avoid acquiring it until something actually needs it and, perhaps
# more interestingly, the stylesheet gets a real prerequisite
# representing the program that generated it. If the selected Tailwind
# artifact changes, site.css then becomes out of date through the normal
# dependency graph.
#
# Note that this executable belongs to the build machinery. It is
# neither installed with the website nor placed in the distribution. A
# build from a distribution performs the same host selection and
# acquires its own copy.
#
tailwind_cli = exe{tailwindcss}

# Unix Tailwind releases are ordinary files with the executable bit
# expected to be set after downloading. The Windows release already has
# executable semantics in the first place. Record that distinction here
# so the recipe below doesn't have to infer it from the artifact name.
#
tailwind_chmod = ($build.host.class != 'windows')

$tailwind_cli:
{
  install = false
}
{{
  # There are a few inputs here that build2 cannot see in the usual way.
  # Perhaps the obvious one is the URL: changing it may mean a
  # completely different artifact with $> itself unchanged.
  #
  # The checksum is perhaps even more interesting since the URL could
  # stay exactly the same and yet we may now expect different bytes. And
  # then there is $tailwind which, if set, changes where those bytes
  # come from.
  #
  # So let's remember all three.
  #
  depdb string "$tailwind_url"
  depdb string "$tailwind_sha256"
  depdb string "$tailwind"

  # curl can get some of its configuration from the environment. We
  # could probably ignore most of this in the common case, but then
  # changing, say, the certificate setup would be invisible to the
  # recipe. So remember the variables curl may look at as well.
  #
  depdb env SSL_CERT_DIR SSL_CERT_FILE CURL_CA_BUNDLE http_proxy https_proxy no_proxy

  diag tailwindcss $>

  # Now, acquiring directly into $> would be tempting but it gives us a
  # slightly unpleasant case if the operation is interrupted: we could
  # leave what looks like a perfectly good target containing only part
  # of the artifact.
  #
  # So do the acquisition into a temporary file and move it into place
  # once we have checked everything. And since a previous attempt may
  # have stopped before the move, get rid of an old temporary file
  # first.
  #
  t = "$path($>).t"
  rm -f "$t"

  if ("$tailwind" != '')
  {
    # If $tailwind is set then there is nothing to download. Still,
    # let's copy it to the temporary file rather than straight to $>.
    # This way the local artifact goes through exactly the same check
    # below and we only have one path by which $> can appear.
    #
    cp "$tailwind" "$t"
  }
  else
  {
    # Otherwise fetch the selected release artifact. The release URL may
    # redirect, hence --location. A few retries are useful for the usual
    # transient network failures and there isn't much value in curl
    # printing anything when everything went fine.
    #
    $curl --fail        \
          --silent      \
          --show-error  \
          --location    \
          --retry 3     \
          --output "$t" "$tailwind_url"
  }

  # We have something that looks like the artifact now, so check that it
  # is actually the one selected in tailwind.build before going any
  # further.
  #
  sha256sum --sum-only "$t" | set sum

  if ("$sum" != "$tailwind_sha256")
  {
    # Perhaps we could leave the bad file around for inspection, but
    # there is little useful state in it that isn't already captured by
    # the two checksums below. More awkwardly, it would look like
    # unfinished state from the next attempt. So remove it.
    #
    rm -f "$t"

    exit "$tailwind_artifact does not have its expected checksum: wanted \
$tailwind_sha256, got $sum"
  }

  if $tailwind_chmod
  {
    # On Unix the downloaded artifact still needs to be made executable.
    #
    $chmod +x "$t"
  }

  # And now the temporary file is the artifact we wanted and, on hosts
  # where it matters, is executable. So this is the point where we can
  # finally give it the target name.
  #
  mv "$t" $path($>)
}}

# tailwind.css is what we edit and site.css is what the website loads.
# They live at the same relative place in the source and output trees,
# which is convenient, though we still want different names here so the
# authored file and the generated one remain unambiguous to the build.
#
tailwind_in = css{tailwind}

# Tailwind has to scan the HTML before it knows which utility classes to
# emit. The slightly awkward part is that those files are discovered
# through @source in tailwind.css and never appear on the command line
# below. Tailwind knows about them, in other words, but build2 does not.
#
# Note that release-row.html is in this set as well. It never becomes a
# page of its own, but the release archive is built from it and its
# utility classes have to reach site.css like any others.
#
# So list the same files here and make them real prerequisites of
# site.css. There are now two descriptions of the scan set, which is
# perhaps easy to get out of sync. Automatic discovery is disabled in
# tailwind.css and the testscript compares its @source entries with this
# list, so forgetting one side should be caught fairly quickly.
#
tailwind_scan = html{index 404} file{release-row.html}

css{site}: $tailwind_in $tailwind_cli $tailwind_scan
{
  install = data/www/
}
{{
  diag tailwindcss $>

  # This pipe perhaps deserves an explanation. Tailwind changes the
  # state of the stderr descriptor it inherits. If we hand it the
  # recipe's stderr directly, that change can still be visible to
  # build2's in-process builtins after Tailwind exits.
  #
  # So put a pipe in between and let cat copy the diagnostics back to
  # stderr. Tailwind can then do whatever it does to its end of the pipe
  # without changing the descriptor that build2 keeps using.
  #
  $tailwind_cli --input $path($tailwind_in) --output $path($>) --minify 2>&1 | cat >&2

  # There is one more slightly odd Tailwind detail here. If regenerating
  # the stylesheet produces exactly the same CSS, Tailwind leaves the
  # existing output file alone.
  #
  # Say index.html becomes newer but the edit doesn't add or remove any
  # utility classes. We come through this recipe, Tailwind finds that
  # site.css already has the right contents, and its timestamp remains
  # older than index.html. The next build would then come through here
  # again for no useful reason.
  #
  # So touch the target after a successful run. In the unchanged-content
  # case that simply records that we have already considered the current
  # inputs.
  #
  touch $path($>)
}}

# The release archive is a slightly unusual part of index.html. Most of
# the page is authored directly and the build more or less carries that
# material through to the published page. The archive cannot quite work
# that way since its contents are the release history of iw4x-client and
# that history changes independently of this project.
#
# upstream/iw4x-client/releases.build contains the configuration side of
# this: which repository we ask, which asset we are interested in, and
# so on. What remains here is perhaps best thought of as two steps.
# First we acquire one release feed and keep it as part of the build
# output. Then the page rule below turns that feed into the archive
# markup.
#

# Start with the feed. Giving it a proper target is useful for much the
# same reason that we give the Tailwind output one. The page can name
# the release history as an ordinary prerequisite and build2 can decide
# whether acquiring it is necessary from the dependency graph.
#
# Note that acquiring the feed is deliberately a one-time operation for
# a configuration. Once we have a copy, an ordinary incremental build
# keeps using that copy. This gives us two useful properties. Builds can
# continue offline after the initial acquisition and repeated builds of
# the same configuration keep seeing the same release history.
#
# If we want a newer history, that is an explicit operation described
# below by update-releases.
#
releases_feed = json{releases}

$releases_feed:
{
  install = false
}

{{
  # There is one slightly awkward case here. releases_snapshot is a
  # configured path and not a target prerequisite, so build2 has nothing
  # from which to notice that somebody edited the file behind that path.
  #
  # Making the snapshot an ordinary prerequisite would perhaps seem like
  # the natural solution. It does not quite work for an arbitrary
  # configured path. In particular, a path naming a file in another
  # build2 project can be interpreted in terms of that project's output
  # tree. Our tests use a snapshot from this project, which is enough to
  # make that distinction observable in practice.
  #
  # So read the snapshot here and put its parsed contents into the
  # depdb. Note that we serialize the JSON value and do not hash the
  # bytes from the file. Formatting the snapshot differently should not
  # rebuild anything if it still describes exactly the same release
  # feed.
  #
  releases_snapshot_state = ''
  if ($releases_snapshot != [null])
    releases_snapshot_state = $json.serialize($json.load($releases_snapshot), 0)

  # There are two more inputs that have the same property. The URL comes
  # from configuration and the choice between the network and snapshot
  # paths is itself configuration state. Neither has a prerequisite
  # standing in for it, so remember them.
  #
  # This is the same idea as the Tailwind acquisition rule: if something
  # can change what bytes we acquire and there is no target through
  # which build2 can observe that change, put it in the depdb.
  #
  depdb hash "$releases_snapshot_state"
  depdb string "$releases_api_url"
  depdb string "$releases_snapshot"

  # curl has a few less visible inputs of its own. Certificate lookup
  # and proxy selection come from the environment, and changing either
  # can change the result of the request. Record the variables curl may
  # consult here.
  #
  depdb env SSL_CERT_DIR SSL_CERT_FILE CURL_CA_BUNDLE http_proxy https_proxy no_proxy

  diag curl $>

  # Acquire into a sibling temporary file first. We only want
  # releases_feed to appear once we have the complete input.
  #
  # Writing directly to $> has an unpleasant failure mode: an
  # interrupted transfer can leave a truncated file at the target path.
  # The next rule then sees what looks like an existing feed and fails
  # later with a JSON error, which points at the wrong part of the
  # build.
  #
  # Moving a complete temporary file into place gives the target a much
  # simpler invariant: if it exists, it contains the complete result of
  # the acquisition.
  #
  t = "$path($>).t"

  rm -f "$t"

  if ("$releases_snapshot" != '')
  {
    # A snapshot stands in for the request completely. Still copy it
    # through the temporary file so there is only one point below at
    # which $> becomes the acquired feed.
    #
    cp "$releases_snapshot" "$t"
  }
  else
    $curl $releases_curl_options --output "$t" "$releases_api_url"

  mv "$t" $path($>)
}}

# Now consider refreshing the release history.
#
# The acquisition rule above intentionally keeps the first feed it
# obtains. That is the useful behaviour for development, where
# rebuilding the website should not unexpectedly depend on GitHub or
# start producing different output from one invocation to the next.
#
# A deployment has a different need. The archive published today should
# be built from the releases that exist today. A CI configuration
# naturally gets this from its empty output directory, since there is no
# releases_feed yet. For a persistent configuration we make the refresh
# explicit:
#
#   b 'www/alias{update-releases}' b
#
# Note that the second build matters. update-releases replaces the feed
# target. The normal page rule then observes that changed prerequisite
# and regenerates the pages from it.
#
# We could perhaps implement this alias by deleting releases_feed and
# leaving the acquisition rule to recreate it on the following build.
# Keeping the old feed until a new one has been acquired is nicer. A
# failed refresh then leaves the configuration with its previous usable
# archive instead of no archive.
#
# One other detail here is perhaps surprising: releases_feed is a
# prerequisite of a recipe whose purpose is to replace it. We need the
# target matched before $path() can give us its path, and making it a
# prerequisite is how this recipe gets that matched target. If the feed
# already exists, matching it is cheap as the network request still
# happens exactly once, below.
#
alias{update-releases}: $releases_feed
{{
  diag curl $<

  # Use $path() directly when forming the temporary name. In build2 a
  # '.' is a perfectly ordinary character in a variable name, so writing
  # "$f.t" would ask for a variable named f.t. That failure is
  # particularly easy to miss here since the expansion would simply be
  # empty.
  #
  t = "$path($<[0]).t"

  rm -f "$t"

  if ("$releases_snapshot" != '')
    cp "$releases_snapshot" "$t"
  else
    $curl $releases_curl_options --output "$t" "$releases_api_url"

  mv "$t" $path($<[0])
}}

# And now the pages.
#
# We used to have one rule for English and another for the translated
# pages. That worked reasonably well when the translated rule had one
# extra job, namely running msgfmt. With the release archive there is
# now quite a bit of work after that point which is exactly the same for
# every language.
#
# We could perhaps still keep the two rules and duplicate that part, but
# then every change to how a release row is written would have to be
# made in both places. So let's keep one rule and make English the
# simple case where there is no msgfmt step.
#
# Note that the recipe below refers to its prerequisites by position.
# Keep the order here in sync with those uses:
#
# [0]  authored index.html
# [1]  acquired release feed
# [2]  release-row.html
# [3]  archive strings in the page language
#
# And, for translated pages:
#
# [4]  PO catalogue
# [5]  ITS rules
# [6]  ITS locating rules
#
pages =

for l: en $linguas
{
  p = html{$l/index}
  pages += $p

  prereqs = html{index} $releases_feed file{release-row\.html}

  if ($l == 'en')
  {
    # English is our source language. po/strings.html already contains
    # the strings in the form needed by the English page, so use it
    # directly.
    #
    prereqs += $strings
  }
  else
  {
    # Give each translated page exactly the catalogue msgfmt will read
    # for that page.
    #
    # Depending on every PO file here would work mechanically, but it
    # would make an edit to fr.po invalidate de/index.html and every
    # other language. There is no dependency between those pages, so
    # expressing one would just create needless rebuilds.
    #
    prereqs += ../po/html{$l/strings} po{$src_root/po/$l} $its $loc
  }

  $p: $prereqs
  {
    install = data/www/$l/
    lang = $l
  }

  {{
    # First parse the release feed. json.load() is impure as far as
    # build2 is concerned, so it has to happen in the depdb preamble
    # where reading a prerequisite and carrying the resulting value into
    # the recipe is allowed.
    #
    releases = $json.load($path($<[1]))

    # Now record the inputs that can change the result without changing
    # any of the file prerequisites. In particular, the msgfmt
    # executable may remain at the same path after an upgrade, so the
    # path alone does not describe the msgfmt we used to produce this
    # page. Its version does.
    #
    # The configured origin and release archive settings are similar in
    # this respect. They become text in the generated page, though there
    # is no file prerequisite whose timestamp can stand for them. So
    # keep these values in depdb and let a change to any one of them
    # rerun the recipe.
    #
    depdb string "$msgfmt_version"
    depdb string "$url"
    depdb string "$lang"
    depdb string "$releases_count"
    depdb string "$releases_asset"

    # msgfmt finds the ITS data directory through GETTEXTDATADIR. There
    # is nothing in its command line from which build2 could rediscover
    # that value, so record the environment variable.
    #
    depdb env GETTEXTDATADIR

    diag gen $>

    # A successful GitHub releases response is an array. An error
    # response may instead be an object, and a configured snapshot can
    # of course contain whatever was put into it. curl --fail protects
    # the normal network path, though it cannot say anything about a
    # snapshot that we were given directly.
    #
    # So check the shape here, before we start treating the value as a
    # sequence of release records. Bail out if it is something else.
    # Otherwise the failure tends to show up much later in the archive
    # loop where the actual problem, namely a bad feed, is considerably
    # less obvious.
    #
    if ($json.value_type($releases) != 'array')
      exit "$path($<[1]) is not a list of releases"

    o = $path($>)

    # Build the page through an intermediate file. At this point $t will
    # become the complete page in the requested language with the
    # release marker intact. Near the end of the recipe we copy it to $>
    # and replace that marker with the generated rows.
    #
    # It is tempting to write the translated page directly to $> and
    # then modify it in place. Keeping $> for the final form gives us a
    # nicer invariant: once something is written there, it is already in
    # the form expected by the target. A failed release expansion cannot
    # leave a partially processed page at the target path.
    #
    t = "$path($>).t"

    if ($lang == 'en')
    {
      # Keep the production origin in the authored document. This makes
      # the source page useful on its own and, perhaps more importantly
      # here, gives the build one stable string from which configured
      # deployments can be produced.
      #
      # English needs no msgfmt pass, so replacing that origin is all
      # that is needed before release expansion.
      #
      sed -e "s|https://iw4x\\.io|$url|g" $path($<[0]) >"$t"
    }
    else
    {
      # Ask msgfmt to replace source text in the template with
      # translated text. The --replace-text detail is easy to overlook:
      # XML mode without it retains the source text and places the
      # translation beside it. That is useful for some XML workflows,
      # though it is not the document structure that this site
      # publishes.
      #
      x = "$path($>).x"

      env "GETTEXTDATADIR=$gettextdatadir" -- \
        $msgfmt --xml -L iw4x --replace-text "--template=$path($<[0])" \
                --locale=$lang --output-file="$x" $path($<[4])

      # We now have the translated document. msgfmt's XML serializer
      # gets us quite close to the HTML source, with a few serialization
      # details that need to be put back into the form used by the site.
      #
      # Start with the prologue. msgfmt writes an XML declaration and
      # retains the doctype from the template. For text/html we want a
      # single doctype at the beginning of the document. Blank the
      # retained doctype first and then turn the XML declaration into
      # the doctype we keep.
      #
      # Note that this order matters. If we introduced the new doctype
      # first, the expression which removes the old one could see the
      # newly-created line as well. Leaving the removed line empty costs
      # us nothing and saves another pass whose sole job would be
      # deleting it.
      #
      # Note also that msgfmt puts xml:lang on translated elements. This
      # page has one language for the entire document, so put that
      # language on the root html element and remove the repeated
      # attributes from its descendants.
      #
      # Finally, adjust the canonical URL and site origin. The authored
      # page always names /en and the production origin, which gives us
      # stable text to match here. Rewrite /en for the language being
      # generated first, then substitute the configured origin.
      #
      sed -e 's|^<!DOCTYPE html>$||'                                                                                                                             \
          -e 's|^<[?]xml[^>]*[?]>$|<!DOCTYPE html>|'                                                                                                             \
          -e 's| xml\:lang="[a-z]*"||g'                                                                                                                          \
          -e "s|<html xmlns=\"http\://www\.w3.org/1999/xhtml\" lang=\"en\">|<html xmlns=\"http\://www\.w3.org/1999/xhtml\" lang=\"$lang\" xml\:lang=\"$lang\">|" \
          -e "s|rel=\"canonical\" href=\"https\://iw4x\\.io/en\"|rel=\"canonical\" href=\"https\://iw4x.io/$lang\"|"                                             \
          -e "s|https\\\\://iw4x\\\\.io|$url|g"                                                                                                                  \
          "$x" >"$t"

      # Nothing below needs the serializer output. msgfmt created $x
      # directly through --output-file, so it is our scratch file to
      # dispose of once the normalization pass has consumed it.
      #
      rm -f "$x"
    }

    # Next get the small pieces of translated prose that are inserted
    # into each generated release row.
    #
    # po/strings.html is the authored English document. po/buildfile
    # produces the corresponding translated document for every other
    # language. From the point of view of this recipe prerequisite [3]
    # is simply the XHTML string document for the language we are
    # generating.
    #
    # The element ids are the interface between that document and this
    # recipe. Keeping that interface explicit is useful here:
    # translators work with normal document text and the archive
    # generator only needs to know which pieces it is looking for.
    #
    s = $path($<[3])

    sed -n -e 's%^ *<p id="release-date"[^>]*>(.+)</p>$%\1%p' "$s" | \
      set date_pattern

    sed -n -e 's%^ *<p id="release-changelog"[^>]*>(.+)</p>$%\1%p' "$s" | \
      set notes_label

    sed -n -e 's%^ *<p id="release-download"[^>]*>(.+)</p>$%\1%p' "$s" | \
      set download_label

    # Treat a missing string as a mismatch in that interface. An empty
    # match would otherwise turn into an empty label on every generated
    # row, which makes a typo in an id look like valid output.
    #
    # Bail out here where we still know what was being extracted and can
    # point at the two files that have to agree.
    #
    if ("$date_pattern" == '' || "$notes_label" == '' || "$download_label" == '')
      exit "$s does not have the strings the release archive needs; \
po/strings.html and www/buildfile have to agree on the ids"

    # Note that these three values are already markup text. The authored
    # XHTML carries escaped text at its source and msgfmt escapes
    # translated text as part of XML serialization. Escaping the strings
    # a second time here would turn, say, an existing '&amp;' into
    # '&amp;amp;'.
    #
    # Values read from the JSON feed have not gone through an HTML
    # serializer. Those are plain strings, so we will escape them later
    # once we know whether a value is being placed in element text or
    # inside a quoted attribute.
    #
    # Read the row template once now. The markup itself is independent
    # of the page language. The generated release values and the strings
    # extracted above are the parts that vary for each row.
    #
    cat $path($<[2]) | set -n row

    # We can now copy the translated page to its final target and expand
    # the archive marker when we encounter it.
    #
    # A line-at-a-time copy is perhaps a little pedestrian, though it
    # has a useful property for this job: everything outside the marker
    # travels from $t to $> unchanged. None of that text has to become
    # part of a substitution expression.
    #
    # Replacing the marker with one large sed replacement would put the
    # whole generated fragment through sed's replacement syntax. Release
    # names and URLs come from the feed, so such a replacement would
    # need another layer of escaping whose exact form depends on the
    # generated values and the delimiter picked for sed. There is little
    # benefit in introducing that representation here.
    #
    true >$o

    for -n line <="$t"
    {
      if $regex.match("$line", '^ *<!--@releases@-->$')
      {
        # Preserve the marker's indentation. release-row.html
        # intentionally starts its lines at column zero, so the template
        # does not have to know where index.html happens to place the
        # archive.
        #
        # This gives the marker ownership of indentation and lets the
        # row template remain reusable if the surrounding markup moves
        # later.
        #
        indent = $regex.replace("$line", '^( *)<!--@releases@-->$', '\1')

        n = [uint64] 0

        for r: $releases
        {
          # Drafts have not been published and prereleases are outside
          # the history represented by this archive, so neither is a
          # candidate for a row.
          #
          # An unauthenticated GitHub releases response normally leaves
          # drafts out. Keep the test here all the same. Authenticated
          # feeds and hand-written snapshots need not have the same
          # omission.
          #
          # Some older snapshots do not contain Boolean members. Treat a
          # missing member as false, matching the meaning of the normal
          # public feed in the cases we care about.
          #
          draft = ($r[draft])
          prerelease = ($r[prerelease])

          if ($draft == [null])
            draft = false

          if ($prerelease == [null])
            prerelease = false

          publish = true

          if $draft
            publish = false

          if $prerelease
            publish = false

          # Stop selecting rows once the configured archive size has
          # been reached. We still finish walking the feed, which keeps
          # selection expressed in one place and avoids giving the loop
          # a second exit condition.
          #
          if ($n == $releases_count)
            publish = false

          if $publish
          {
            tag = ($r[tag_name])
            published = ($r[published_at])
            notes_url = ($r[html_url])

            # These are the minimum fields needed to construct a release
            # row. A selected record without one of them cannot be
            # represented by the template in any useful way, so bail out
            # before deriving anything from incomplete data.
            #
            if ($tag == [null] || $published == [null] || $notes_url == [null])
              exit "a release in $path($<[1]) is missing tag_name, \
published_at or html_url"

            # The archive displays the publication day and leaves the
            # time out. GitHub gives us an ISO timestamp, so first
            # reduce it to the calendar date and then split that into
            # the three fields used by the translated date pattern.
            #
            # Note that the ordering is intentionally absent from this
            # code. strings.html decides where year, month, and day
            # appear for each language. The recipe only supplies those
            # fields.
            #
            if (!$regex.match("$published", '^\d{4}-\d{2}-\d{2}T.*$'))
              exit "release $tag has an unexpected published_at value \
in $path($<[1]): $published"

            date = $regex.replace("$published", '^(\d{4}-\d{2}-\d{2})T.*$', '\1')

            year = $regex.replace("$date", '^(\d{4})-\d{2}-\d{2}$', '\1')
            month = $regex.replace("$date", '^\d{4}-(\d{2})-\d{2}$', '\1')
            day = $regex.replace("$date", '^\d{4}-\d{2}-(\d{2})$', '\1')

            # Month names are stored in strings.html under ids
            # containing the two-digit month number. Build the sed
            # expression from a fixed literal and then put the month
            # into its one placeholder.
            #
            # We could perhaps interpolate $month directly into a
            # double-quoted sed expression. That makes the end anchor
            # and backreference cross another level of build2 quoting,
            # and a quoting mistake there tends to present itself as an
            # empty match. Keeping the expression literal up to this
            # point makes it much easier to see which syntax belongs to
            # sed and which part is the value we are inserting.
            #
            month_expr = $string.replace(\
              's%^ *<p id="release-month-@month@"[^>]*>(.+)</p>$%\1%p', \
              '@month@', "$month")

            sed -n -e "$month_expr" "$s" | set month_name

            if ("$month_name" == '')
              exit "$s has no name for month $month"

            # GitHub uses two digits for the day. The display form does
            # not need the leading zero on the first nine days of a
            # month, so trim that one case before inserting the value
            # into the pattern.
            #
            day = $regex.replace("$day", '^0(\d)$', '\1')

            # Fill the structural date fields first and insert the
            # translated month name last.
            #
            # The month name is free translated text. Delaying its
            # insertion keeps that text out of the earlier placeholder
            # searches, which means its contents can never accidentally
            # look like one of our structural tokens.
            #
            date_text = $string.replace("$date_pattern", '{year}', "$year")
            date_text = $string.replace("$date_text", '{day}', "$day")
            date_text = $string.replace("$date_text", '{month}', "$month_name")

            # Start the download link at the release page. A release
            # still belongs in the archive when it does not carry the
            # configured client asset, and the release page is a useful
            # destination in that case.
            #
            # If the asset is present, use its browser download URL
            # instead.
            #
            download_url = "$notes_url"

            for a: ($r[assets])
            {
              if (($a[name]) == $releases_asset)
                download_url = ($a[browser_download_url])
            }

            # Escape the values that came from JSON now that their
            # destination in the template is known.
            #
            # The tag becomes element text. Escape '&' first so entities
            # introduced by the later replacements are left alone, then
            # escape the angle brackets that could otherwise be
            # interpreted as markup.
            #
            # The two URLs go into double-quoted attributes. Here the
            # dangerous characters are '&' and the quote that could
            # terminate the attribute value.
            #
            # date_text needs no corresponding pass. Its translated
            # pieces came from XHTML and have already been serialized
            # safely. The fields we inserted into that text ourselves
            # contain decimal digits.
            #
            tag_text = $string.replace("$tag", '&', '&amp;')
            tag_text = $string.replace("$tag_text", '<', '&lt;')
            tag_text = $string.replace("$tag_text", '>', '&gt;')

            notes_href = $string.replace("$notes_url", '&', '&amp;')
            notes_href = $string.replace("$notes_href", '"', '&quot;')

            download_href = $string.replace("$download_url", '&', '&amp;')
            download_href = $string.replace("$download_href", '"', '&quot;')

            # Keep the generated section formatted like the authored
            # markup by putting one empty line between rows. Start from
            # the second row so replacing the marker does not introduce
            # an empty line before the first release.
            #
            if ($n != 0)
              echo '' >>$o

            for rl: $row
            {
              if ("$rl" == '')
              {
                # Keep an empty template line truly empty. Prefixing the
                # marker indentation here would turn a formatting-only
                # blank line into a line containing trailing whitespace
                # in every generated page.
                #
                echo '' >>$o
              }
              else
              {
                # Expand the descriptive placeholders before the shorter
                # ones. Each replacement then owns one complete token
                # and a future template can introduce related names
                # without a shorter token consuming part of a longer one
                # first.
                #
                # At this point every replacement value is already in
                # the form required by its destination, so this loop has
                # one job: fill the template and restore the indentation
                # inherited from the archive marker.
                #
                e = $string.replace("$rl", '@date-text@', "$date_text")
                e = $string.replace("$e", '@date@', "$date")
                e = $string.replace("$e", '@tag@', "$tag_text")
                e = $string.replace("$e", '@notes-url@', "$notes_href")
                e = $string.replace("$e", '@notes-text@', "$notes_label")
                e = $string.replace("$e", '@download-url@', "$download_href")
                e = $string.replace("$e", '@download-text@', "$download_label")

                echo "$indent$e" >>$o
              }
            }

            n += 1
          }
        }

        # Seeing the marker and producing no rows means the configured
        # release source cannot provide the archive this page is meant
        # to contain. This can happen when there are no publishable
        # releases or when a supplied snapshot describes some other
        # release history.
        #
        # An empty archive would still be syntactically valid HTML,
        # which makes silently accepting it particularly unhelpful. Bail
        # out here and point at the release source configuration
        # instead.
        #
        if ($n == 0)
          exit "no releases to publish in $path($<[1]); check \
config.iw4x_website.releases.repository"
      }
      else
        echo "$line" >>$o
    }

    # Leave $t in place when the recipe ends. The redirection which
    # produced it registered that path with build2, so build2 owns the
    # temporary output and removes it as part of recipe cleanup.
    #
  }}
}

# We need the same language alternation in a couple of places below. We
# could construct it independently each time, though that would give us
# two bits of code that are supposed to describe the same language set.
#
# So build it once here. LINGUAS contains the translated languages and,
# as a result, does not contain English. Add it explicitly before
# forming the alternation.
#
locales = $regex.merge(en $linguas, '(.+)', '\1', '|')

# The sitemap has one URL entry for every language page, with each entry
# naming the other language versions of the same document.
#
# It may be tempting to make the generated pages prerequisites here. The
# sitemap never reads them though. All it needs is the language set and
# the origin. Changing a sentence in fr.po cannot change sitemap.xml, so
# depending on html{fr/index} would only make that edit rebuild
# something whose contents are already known to be unchanged.
#
xml{sitemap}:
{
  install = data/www/
}
{{
  # Neither of the two things we actually use to form the URLs is
  # represented by a file prerequisite, so remember them in the depdb.
  #
  depdb string "$url"
  depdb string "$locales"

  diag gen $>

  o = $path($>)

  # Start with the prologue and then append one entry per language.
  # There is no intermediate format here and no external program
  # producing the file for us, so writing the target directly keeps this
  # recipe pleasantly simple.
  #
  echo '<?xml version="1.0" encoding="UTF-8"?>' >$o
  echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">' >>$o

  for l: en $linguas
  {
    echo "  <url>" >>$o
    echo "    <loc>$url/$l</loc>" >>$o

    # Now repeat the full alternate set for this URL. It looks a little
    # repetitive when generated, but each entry has to describe its
    # relation to every other language version, so there isn't really
    # anything to factor out in the resulting XML.
    #
    for a: en $linguas
    {
      echo "    <xhtml:link rel=\"alternate\" hreflang=\"$a\" href=\"$url/$a\"/>" >>$o
    }

    # And use English for the language-neutral entry.
    #
    echo "    <xhtml:link rel=\"alternate\" hreflang=\"x-default\" href=\"$url/en\"/>" >>$o
    echo "  </url>" >>$o
  }

  echo '</urlset>' >>$o
}}

# robots.txt is almost static. The awkward bit is the Sitemap line,
# since its origin follows $url and cannot simply be written once in the
# source tree.
#
# We could add a template for that single substitution. With only four
# lines to produce, writing the file here is perhaps easier to read.
#
file{robots.txt}:
{
  install = data/www/
}
{{
  # $url is the only bit of configuration that can change the result.
  #
  depdb string "$url"

  diag gen $>

  o = $path($>)

  echo 'User-agent: *' >$o
  echo 'Allow: /' >>$o
  echo '' >>$o
  echo "Sitemap: $url/sitemap.xml" >>$o
}}

# The language part of the URL belongs to the site itself, so keep the
# matching server rules here with the rest of the site.
#
# Most of .htaccess is ordinary authored text and lives in htaccess.in.
# The language alternation is the one part that is awkward to write
# there, since it has to follow LINGUAS. So leave a @locales@ hole in
# the template and fill it from the value above.
#
file{.htaccess}: file{htaccess.in}
{
  install = data/www/
}
{{
  # Changing LINGUAS changes $locales without changing htaccess.in, so
  # remember the value explicitly.
  #
  depdb string "$locales"

  diag gen $>

  sed -e "s,@locales@,$locales,g" $path($<) >$path($>)
}}

# 404.html and favicon.ico need no work at all. The @./ qualification is
# worth spelling out though: these are the files in the source
# directory, not targets that we expect some rule to produce in the
# output directory.
#
static = html{404}@./ file{favicon.ico}@./

$static: install = data/www/

# index.html is a slightly different case. It is source for the page
# rules above and should never appear in the installed tree by itself.
# Since html derives from doc, it would otherwise pick up the usual
# installation semantics. Turn those off for this source target.
#
html{index}@./: install = false

# And finally collect the whole site under the directory target.
#
./: css{site} $pages xml{sitemap} $static inter/ \
    file{robots.txt .htaccess}
