# Our own assembly definition for source-highlight. The one it ships
# with doesn't work for the listings in our posts: it predates x64, so it
# knows none of the 64-bit registers, and it takes a MASM number such as
# 616A8h for two numbers with a letter in between.
#
# What we need from it is modest, though. The site's stylesheet only
# colors function names and comments (see .prose pre in tailwind.css),
# and in a listing the closest thing to a function name is the name of
# the instruction. So that, along with the comments, is all we pick out.
#
comment start ";"

# IDA's disassembly, with the address, a colon, and the instruction
# (14002391C: imul rax, rbx, 2008h).
#
(normal,function) = `(^[[:xdigit:]]+:[[:blank:]]+)([[:alpha:]][[:alnum:]]*)`

# A stub of ours in MASM, where an instruction is indented and a label or
# a directive such as PROC is not, which keeps those plain.
#
(normal,function) = `(^[[:blank:]]+)([[:alpha:]][[:alnum:]]*)`
