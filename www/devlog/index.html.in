<!DOCTYPE html>

<!--
  This is the devlog index. The build replaces the posts marker below with
  one post-row.html for each entry in posts.json, in the same order, which
  is newest first.

  The hero is the same as on the homepage. See index.html for how its
  layers work.
-->

<html xmlns="http://www.w3.org/1999/xhtml" lang="en" xml:lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Devlog - IW4x</title>

    <meta name="description" content="Technical notes on the code, tools and decisions behind IW4x." />

    <meta name="application-name" content="IW4x" />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href="https://iw4x.io/devlog" />

    <link rel="preload" as="font" type="font/woff2" href="../inter/latin.woff2" crossorigin="anonymous" />
    <link rel="icon" href="../favicon.ico" sizes="any" />
    <link rel="stylesheet" href="../site.css" />

    <script type="module" src="../hero/main.js"></script>
  </head>

  <body class="flex min-h-svh flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:inline-flex focus:min-h-11 focus:min-w-11 focus:items-center focus:border focus:border-border focus:bg-background focus:px-4 focus:font-semibold focus:text-foreground"
      >Skip to main content</a
    >

    <header class="theme-dark absolute inset-x-0 top-0 z-10 px-6">
      <nav aria-labelledby="site-nav-label" class="mx-auto flex min-h-18 w-full max-w-5xl items-center justify-center">
        <span id="site-nav-label" class="sr-only">Main</span>

        <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 min-[30rem]:gap-x-7">
          <li>
            <a
              href="/en#about"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm tracking-body text-muted underline-offset-4 transition-[color] duration-150 ease-out hover:text-foreground hover:underline"
              >About IW4x</a
            >
          </li>

          <li>
            <a
              href="/en#servers"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm tracking-body text-muted underline-offset-4 transition-[color] duration-150 ease-out hover:text-foreground hover:underline"
              >Server hosting</a
            >
          </li>

          <li>
            <a
              href="/en#releases"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm tracking-body text-muted underline-offset-4 transition-[color] duration-150 ease-out hover:text-foreground hover:underline"
              >Release archive</a
            >
          </li>

          <li>
            <a
              href="/devlog"
              aria-current="page"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm tracking-body text-foreground underline underline-offset-4 transition-[color] duration-150 ease-out hover:text-foreground"
              >Devlog</a
            >
          </li>
        </ul>
      </nav>
    </header>

    <main id="main-content" tabindex="-1" class="flex flex-1 flex-col">
      <section aria-labelledby="devlog-heading" class="theme-dark relative isolate flex min-h-120 w-full flex-col items-center justify-center overflow-hidden bg-background px-6 pt-28 pb-16 text-center text-foreground">
        <div
          id="hero-scene"
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-1000 ease-out data-ready:opacity-100 motion-reduce:transition-none"
        >
          <div class="absolute inset-0 bg-radial-[at_50%_42%] from-background/60 via-background/15 via-65% to-transparent"></div>
          <div class="absolute inset-0 bg-linear-to-b from-background/40 via-background/15 via-45% to-background"></div>
        </div>

        <div class="flex w-full max-w-180 flex-col items-center">
          <h1 id="devlog-heading" class="text-display font-bold tracking-display text-foreground"
            ><span translate="no">IW4<span class="text-wordmark-accent">x</span></span
            ><span class="mt-4 block text-heading tracking-heading">Devlog</span></h1
          >

          <p class="mt-6 text-lg tracking-body text-balance text-muted">Technical notes on the code, tools and decisions behind IW4x.</p>
        </div>
      </section>

      <section aria-labelledby="posts-heading" class="w-full border-t border-rule px-6 py-16">
        <div class="mx-auto w-full max-w-prose-page">
          <h2 id="posts-heading" class="text-heading font-bold tracking-heading text-foreground">All posts</h2>

          <ol class="mt-8 border-t border-rule">
            <!--@posts@-->
          </ol>
        </div>
      </section>
    </main>

    <footer class="w-full border-t border-rule px-6 pt-5 pb-10">
      <nav aria-labelledby="footer-label" class="mx-auto mb-6 max-w-5xl">
        <span id="footer-label" class="sr-only">More from IW4x</span>

        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
          <li>
            <a
              href="https://discord.com/invite/pV2qJscTXf"
              class="inline-flex min-h-11 items-center text-sm tracking-body text-muted transition-[color] duration-150 ease-out hover:text-foreground hover:underline"
              >IW4x on Discord</a
            >
          </li>

          <li>
            <a
              href="https://github.com/iw4x"
              class="inline-flex min-h-11 items-center text-sm tracking-body text-muted transition-[color] duration-150 ease-out hover:text-foreground hover:underline"
              >IW4x on GitHub</a
            >
          </li>

          <li>
            <a
              href="/en#download"
              class="inline-flex min-h-11 items-center text-sm tracking-body text-muted transition-[color] duration-150 ease-out hover:text-foreground hover:underline"
              >Download IW4x</a
            >
          </li>
        </ul>
      </nav>

      <p class="mx-auto mb-8 max-w-xl text-center text-sm tracking-body text-balance text-muted"
        >IW4x is not affiliated with or endorsed by Activision. Call of Duty and Modern Warfare are trademarks of Activision Publishing, Inc.</p
      >

      <div class="flex justify-center" aria-hidden="true">
        <span class="h-1 w-3 bg-pride-red"></span>
        <span class="h-1 w-3 bg-pride-orange"></span>
        <span class="h-1 w-3 bg-pride-yellow"></span>
        <span class="h-1 w-3 bg-pride-green"></span>
        <span class="h-1 w-3 bg-pride-blue"></span>
        <span class="h-1 w-3 bg-pride-purple"></span>
        <span class="h-1 w-3 bg-pride-brown"></span>
        <span class="h-1 w-3 bg-pride-black"></span>
        <span class="h-1 w-3 bg-pride-light-blue"></span>
        <span class="h-1 w-3 bg-pride-pink"></span>
        <span class="h-1 w-3 bg-pride-white"></span>
        <span class="h-1 w-3 bg-pride-intersex-yellow"></span>
        <span class="h-1 w-3 bg-pride-intersex-purple"></span>
      </div>
    </footer>
  </body>
</html>
